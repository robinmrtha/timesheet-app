# App runtime. Use Neon's pooled connection string.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cloudflare Access application AUD tag (Zero Trust → Access controls → Applications).
ACCESS_AUD=

# Local Vite only (`npm run dev`). Off unless set to exactly 1. Never set this in production.
# ACCESS_DEV_BYPASS=1
# ACCESS_DEV_EMAIL=mira@example.com
# Local only. Uses users.role instead of the HUB service binding. Never set this in production.
# PERMISSIONS_ROLE_FALLBACK=1

# Migration only. Direct Supabase Postgres URL (port 5432, not the transaction pooler).
SUPABASE_DB_URL=postgres://postgres:password@db.projectref.supabase.co:5432/postgres

# Migration only. Direct Neon URL (hostname without -pooler) while applying schema and copying rows.
# DATABASE_URL above can point at the pooler for the running app.

# Migration only. Comma-separated emails to mark inactive. History is kept.
INACTIVE_EMAILS=samnrodriguez@gmail.com
