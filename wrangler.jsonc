{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hbzr-timesheet",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // The apex hbzr.us belongs to hbzr-app. This Worker is only hbzr.us/timesheet*.
  // Do not add a custom domain or a route for the apex or www.
  // wrangler.jsonc is the file Wrangler reads (it prefers this over wrangler.toml).
  // The route is: [[routes]] pattern = "hbzr.us/timesheet*"  zone_name = "hbzr.us"
  "routes": [
    { "pattern": "hbzr.us/timesheet*", "zone_name": "hbzr.us" }
  ],
  // Same contract as wrangler.toml:
  // [[services]]
  // binding = "HUB"
  // service = "hbzr-app"
  // entrypoint = "Hub"
  "services": [
    { "binding": "HUB", "service": "hbzr-app", "entrypoint": "Hub" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Names only. Values are `wrangler secret put` (production) or .dev.vars (local).
  "secrets": {
    "required": ["DATABASE_URL", "ACCESS_AUD"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Keep @vercel/functions out of the Worker bundle. Node and Vercel still
  // import the real package from server/db.js.
  "alias": {
    "@vercel/functions": "./server/vercel-functions-stub.js"
  }
}
