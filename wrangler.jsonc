{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hbzr-timesheet",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Vercel stays on api/index.js. This Worker is not attached to hbzr.us yet,
  // so a deploy does not cut production over. Add the custom domain at cutover
  // (see DEPLOY-CLOUDFLARE.md).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  // Names only. Values are `wrangler secret put` (production) or .dev.vars (local).
  "secrets": {
    "required": ["DATABASE_URL", "AUTH_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Keep @vercel/functions out of the Worker bundle. Node and Vercel still
  // import the real package from server/db.js.
  "alias": {
    "@vercel/functions": "./server/vercel-functions-stub.js"
  }
}
