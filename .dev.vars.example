# Local `wrangler dev` only. Copy to .dev.vars and fill in. Do not commit .dev.vars.
# Production values are set with `npx wrangler secret put`, not in this file.
DATABASE_URL="postgres://timesheet:timesheet@127.0.0.1:5432/timesheet"
# Application Audience (AUD) tag for the Access app in front of this Worker.
# Any non-empty placeholder is enough while ACCESS_DEV_BYPASS is on.
ACCESS_AUD="local-dev-aud"
# Local only. Off unless set to exactly 1. Never set this on the deployed Worker.
# ACCESS_DEV_BYPASS=1
# ACCESS_DEV_EMAIL=mira@example.com
